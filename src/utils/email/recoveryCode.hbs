<html xmlns="http://www.w3.org/1999/xhtml" lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
  </head>

  <body
    style="margin: 0; padding: 0; background-color: #F8FBFF; font-family: Arial, Helvetica, sans-serif;"
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #E8F4FF; padding: 0 0 20px;"
    >
      <tr>
        <td align="center" style="padding: 20px 0;">
          <table
            width="480"
            height="500"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
                    background-color: #FFFFFF;
                    border-radius: 8px;
                    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
                    margin: auto;
                    overflow: hidden;
                "
          >
            <tr>
              <td
                align="center"
                style="
                            background: linear-gradient(to right, #1B89E6 0%, #0B5FA8 50%, #102A43 100%);
                            padding: 20px;
                            border-bottom-left-radius: 30px;
                            border-bottom-right-radius: 30px;
                        "
              >
                <img
                  src="https://coftech-media-store.s3.us-east-1.amazonaws.com/notifications/coftech-logo.png"
                  alt="Coftech Bot Logo"
                  width="100"
                  style="display: block; color: #1B89E6; margin-bottom: 4px;"
                />
                <img
                  src="https://coftech-media-store.s3.us-east-1.amazonaws.com/notifications/hombresin.png"
                  alt="Default Image"
                  width="150"
                  style="display: block; color: #1B89E6;"
                />
              </td>
            </tr>
            <tr>
              <td style="padding: 15px;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td
                      style="text-align: center; color: #0F172A; font-size: 24px; font-weight: bold;"
                    >
                      {{title}}
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-top: 8px;">
                      <p
                        style="margin: 15px; color: #0F172A; font-size: 12px; text-align: center;"
                      >
                        Dear user, we received a request to recover your account
                        password. Use the code below to verify the request and
                        change your password. This code will expire in
                        <span style="font-weight: bold;">{{timeToExpire}}
                          minutes.</span>
                      </p>
                      <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="background-color: #E8F4FF; margin: 5px auto 0; border-radius: 6px;"
                      >
                        <tr>
                          <td style="padding: 15px; text-align: center;">
                            <p style="margin: 0; color: #0F172A;">{{code}}</p>
                          </td>
                        </tr>
                      </table>
                      <p
                        style="margin: 15px; color: #0F172A; font-size: 12px; text-align: center;"
                      >
                        If you did not request this code, please ignore this
                        message and contact us immediately to secure your
                        account.
                      </p>

                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td
                style="padding: 15px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"
              >
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="left">
                      <img
                        src="https://coftech-media-store.s3.us-east-1.amazonaws.com/notifications/coftech-logo.png"
                        alt="Coftech Bot Logo"
                        width="100"
                        style="display: block; color: #1B89E6; margin-bottom: 4px;"
                      />
                    </td>
                    <td align="right">
                      <p style="margin: 0; color:#0F172A ">&copy; 2025
                        Copyright.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>

</html>
